/* ~/.config/rofi/config.rasi
 * Layout + look. Colors come from colors.rasi (written by theme-pick.sh),
 * so this stays theme-agnostic — only spacing, shape, font, sizing here.
 */

@import "colors.rasi"

configuration {
    show-icons:   true;
    display-drun: "apps";
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    /* pull semantic names from colors.rasi */
    bg:        @background;
    bg-alt:    @background-alt;
    fg:        @foreground;
    sel:       @selected;
    on-sel:    @on-selected;
    accent-c:  @accent;
    urgent-c:  @urgent;
    muted-c:   @muted;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @accent-c;
    border-radius:    2px;
    width:            48%;
    padding:          0;
    location:         center;
    anchor:           center;
}

mainbox {
    padding:  18px;
    spacing:  14px;
    children: [ inputbar, listview ];
}

/* ---- search bar ---- */
inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          12px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent-c;
    font:       "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder:       "search…";
    placeholder-color: @muted-c;
    text-color:        @fg;
    cursor:            text;
}

/* ---- grid of results ---- */
listview {
    columns:      4;
    lines:        3;
    spacing:      12px;
    cycle:        true;
    dynamic:      true;
    scrollbar:    true;
    layout:       vertical;
    flow:         horizontal;   /* fill rows left-to-right = real grid */
    fixed-height: true;
}

/* each cell: image fills the cell, label underneath */
element {
    orientation:   vertical;
    padding:       8px;
    spacing:       6px;
    border-radius: 10px;
    background-color: @bg-alt;
}

element normal.normal   { background-color: @bg-alt;    text-color: @fg; }
element alternate.normal { background-color: @bg-alt;   text-color: @fg; }
element selected.normal {
    background-color: @sel;
    text-color:       @on-sel;
    border:           2px;
    border-color:     @accent-c;
}

element-icon {
    size:             7em;        /* big thumbnail; tune to taste */
    horizontal-align: 0.5;
    border-radius:    8px;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       inherit;
}

/* message line (errors etc) */
message { padding: 8px; border-radius: 8px; background-color: @bg-alt; }
textbox { text-color: @fg; }
