/* ~/.config/rofi/picker.rasi
 * Grid picker for wallpaper.sh and theme-pick.sh. Large icons, few columns.
 * Colors come from colors.rasi, regenerated by theme-pick.sh.
 */
@import "colors.rasi"

* {
    background-color: transparent;
    text-color:       @foreground;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @background;
    border:           2px;
    border-color:     @selected;
    border-radius:    4px;
    width:            60%;
    padding:          12px;
}

mainbox {
    spacing:  10px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @background-alt;
    border-radius:    4px;
    padding:          8px 12px;
    children:         [ prompt, entry ];
    spacing:          8px;
}

prompt { text-color: @selected; }
entry  { placeholder: "search"; placeholder-color: @muted; }

listview {
    columns:      4;
    lines:        3;
    spacing:      10px;
    cycle:        true;
    scrollbar:    false;
    fixed-height: true;
}

element {
    orientation:   vertical;
    padding:       8px;
    border-radius: 4px;
    spacing:       6px;
}

element-icon {
    size:          150px;
    border-radius: 3px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element selected {
    background-color: @selected;
    text-color:       @on-selected;
}
