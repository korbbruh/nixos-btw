# ~/.config/swaylock/swaylock.template
# Rendered to ~/.config/swaylock/config by theme-pick.sh.
# swaylock wants bare rrggbb / rrggbbaa (NO leading #).
# Background image: fixed path, copied by wallpaper.sh

# --- effects: blur the wallpaper, subtle vignette ---
effect-blur=10x3
#effect-vignette=0.35:0.4
image=~/.cache/current-wallpaper.jpg
scaling=fill

# --- clock ---
clock
timestr=%H:%M
datestr=%a, %d %b
font=CaskaydiaCove Nerd Font

# --- indicator (the ring) ---
indicator
indicator-radius=110
indicator-thickness=5
indicator-caps-lock

# --- ring colors (themed, bare hex) ---
ring-color=101315
ring-clear-color=798186
ring-ver-color=798186
ring-wrong-color=565d60
ring-caps-lock-color=798186

# --- inside of ring: semi-transparent bg ---
inside-color=101315cc
inside-clear-color=101315cc
inside-ver-color=101315cc
inside-wrong-color=101315cc
inside-caps-lock-color=101315cc

# --- text ---
text-color=cacccc
text-clear-color=cacccc
text-ver-color=cacccc
text-wrong-color=cacccc
text-caps-lock-color=cacccc

# --- highlights ---
key-hl-color=798186
bs-hl-color=565d60
caps-lock-key-hl-color=798186

# --- lines + separator: invisible ---
separator-color=00000000
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
line-caps-lock-color=00000000

# --- behavior ---
ignore-empty-password
show-failed-attempts
