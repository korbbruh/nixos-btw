# ~/.config/swaylock/swaylock.template
# Rendered to ~/.config/swaylock/config by theme-pick.sh.
# swaylock wants bare rrggbb / rrggbbaa (NO leading #).
# Background image: fixed path, copied by wallpaper.sh

# --- effects: blur the wallpaper, subtle vignette ---
effect-blur=5x3
#effect-vignette=0.35:0.4
image=~/.cache/current-wallpaper.jpg
scaling=fill

# --- clock ---
clock
timestr=%H:%M
datestr=%a, %d %b
font=CaskaydiaCove Nerd Font

# --- indicator (the ring) ---
indicator
indicator-radius=110
indicator-thickness=8
indicator-caps-lock

# --- ring colors (themed, bare hex) ---
ring-color=475258
ring-clear-color=7fbbb3
ring-ver-color=7fbbb3
ring-wrong-color=e67e80
ring-caps-lock-color=7fbbb3

# --- inside of ring: semi-transparent bg ---
inside-color=2d353bcc
inside-clear-color=2d353bcc
inside-ver-color=2d353bcc
inside-wrong-color=2d353bcc
inside-caps-lock-color=2d353bcc

# --- text ---
text-color=d3c6aa
text-clear-color=d3c6aa
text-ver-color=d3c6aa
text-wrong-color=d3c6aa
text-caps-lock-color=d3c6aa

# --- highlights ---
key-hl-color=7fbbb3
bs-hl-color=e67e80
caps-lock-key-hl-color=7fbbb3

# --- lines + separator: invisible ---
separator-color=00000000
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
line-caps-lock-color=00000000

# --- behavior ---
ignore-empty-password
show-failed-attempts
