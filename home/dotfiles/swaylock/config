# ~/.config/swaylock/swaylock.template
# Rendered to ~/.config/swaylock/config by theme-pick.sh.
# swaylock wants bare rrggbb / rrggbbaa (NO leading #).
# Background image: fixed path, copied by wallpaper.sh

# --- effects: blur the wallpaper, subtle vignette ---
effect-blur=10x3
#effect-vignette=0.35:0.4
image=~/.cache/current-wallpaper.jpg
scaling=fill

# --- clock ---
clock
timestr=%H:%M
datestr=%a, %d %b
font=CaskaydiaCove Nerd Font

# --- indicator (the ring) ---
indicator
indicator-radius=110
indicator-thickness=5
indicator-caps-lock

# --- ring colors (themed, bare hex) ---
ring-color=32344a
ring-clear-color=7aa2f7
ring-ver-color=7aa2f7
ring-wrong-color=f7768e
ring-caps-lock-color=7aa2f7

# --- inside of ring: semi-transparent bg ---
inside-color=1a1b26cc
inside-clear-color=1a1b26cc
inside-ver-color=1a1b26cc
inside-wrong-color=1a1b26cc
inside-caps-lock-color=1a1b26cc

# --- text ---
text-color=a9b1d6
text-clear-color=a9b1d6
text-ver-color=a9b1d6
text-wrong-color=a9b1d6
text-caps-lock-color=a9b1d6

# --- highlights ---
key-hl-color=7aa2f7
bs-hl-color=f7768e
caps-lock-key-hl-color=7aa2f7

# --- lines + separator: invisible ---
separator-color=00000000
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
line-caps-lock-color=00000000

# --- behavior ---
ignore-empty-password
show-failed-attempts
