[Unit]
Description=Xwayland outside your Wayland
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/xwayland-satellite :2
ExecStartPost=/bin/sh -c 'sleep 1; echo "Xft.dpi: 144" | DISPLAY=:2 /usr/bin/xrdb -merge'
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
